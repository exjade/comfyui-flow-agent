diff --git a/tests/test_video_poll_diagnostics.py b/tests/test_video_poll_diagnostics.py
new file mode 100644
--- /dev/null
+++ b/tests/test_video_poll_diagnostics.py
@@ -0,0 +1,66 @@
+import unittest
+
+from flow_engine.generators.common import (
+    VideoGenerationFailedError,
+    _failure_detail,
+    poll_status,
+)
+
+
+class FailedPollBridge:
+    async def api_request(self, path, body=None, captcha_action=None, method="POST"):
+        return {
+            "status": 200,
+            "data": {
+                "media": [{
+                    "name": "failed-media",
+                    "mediaMetadata": {
+                        "mediaStatus": {
+                            "mediaGenerationStatus": "MEDIA_GENERATION_STATUS_FAILED",
+                            "generationError": {
+                                "reason": "MODEL_NOT_AVAILABLE",
+                                "message": "The selected model cannot process reference images",
+                            },
+                        }
+                    },
+                }]
+            },
+        }
+
+
+class VideoPollDiagnosticTests(unittest.IsolatedAsyncioTestCase):
+    async def test_failed_generation_keeps_google_reason(self):
+        with self.assertRaises(VideoGenerationFailedError) as exc:
+            await poll_status(FailedPollBridge(), "failed-media", "project")
+
+        message = str(exc.exception)
+        self.assertIn("failed-media", message)
+        self.assertIn("MODEL_NOT_AVAILABLE", message)
+        self.assertIn("reference images", message)
+
+    async def test_identifiable_person_failure_has_actionable_message(self):
+        bridge = FailedPollBridge()
+        original = bridge.api_request
+
+        async def with_safety_reason(*args, **kwargs):
+            result = await original(*args, **kwargs)
+            result["data"]["media"][0]["mediaMetadata"]["mediaStatus"][
+                "failureReasons"
+            ] = ["IDENTIFIABLE_PERSON_SAFETY"]
+            return result
+
+        bridge.api_request = with_safety_reason
+        with self.assertRaises(VideoGenerationFailedError) as exc:
+            await poll_status(bridge, "failed-media", "project")
+
+        self.assertIn("classified the reference as an identifiable person", str(exc.exception))
+        self.assertIn("characters generated by Google", str(exc.exception))
+
+    def test_failure_detail_is_bounded(self):
+        detail = _failure_detail({"errorMessage": "x" * 5000})
+        self.assertLessEqual(len(detail), 1800)
+        self.assertIn("errorMessage", detail)
+
+
+if __name__ == "__main__":
+    unittest.main()

+class VideoGenerationFailedError(RuntimeError):
+    """Raised when Flow accepts a video job but later marks it as failed."""
+
+
+def _failure_detail(media_item: dict) -> str:
+    """Extract useful, bounded error information from a Flow poll response."""
+    details = []
+
+    def visit(value, path=""):
+        if len(details) >= 8:
+            return
+        if isinstance(value, dict):
+            for key, child in value.items():
+                child_path = f"{path}.{key}" if path else str(key)
+                lowered = str(key).lower()
+                if any(word in lowered for word in ("error", "reason", "message", "status")):
+                    if isinstance(child, (str, int, float, bool)) and str(child):
+                        details.append(f"{child_path}={child}")
+                    elif child not in (None, {}, []):
+                        encoded = json.dumps(child, ensure_ascii=True, separators=(",", ":"))
+                        details.append(f"{child_path}={encoded[:500]}")
+                visit(child, child_path)
+        elif isinstance(value, list):
+            for index, child in enumerate(value[:8]):
+                visit(child, f"{path}[{index}]")
+
+    visit(media_item)
+    return "; ".join(dict.fromkeys(details))[:1800]
+

+# Flow uses mode-specific model keys for image-conditioned video.  Sending the
+# legacy text-to-video ``abra_t2v_*`` key to an image/reference endpoint can be
+# accepted while silently producing a video unrelated to the supplied image.
+# Keep these keys overridable because Flow's browser API is undocumented.
+VIDEO_INPUT_MODELS = {
+    "i2v": {
+        "landscape": os.environ.get("VIDEO_I2V_LANDSCAPE_MODEL", "veo_3_1_i2v_s_fast"),
+        "portrait": os.environ.get("VIDEO_I2V_PORTRAIT_MODEL", "veo_3_1_i2v_s_fast_portrait"),
+    },
+    "first_last": {
+        "landscape": os.environ.get("VIDEO_FIRST_LAST_LANDSCAPE_MODEL", "veo_3_1_i2v_s_fast_fl"),
+        "portrait": os.environ.get("VIDEO_FIRST_LAST_PORTRAIT_MODEL", "veo_3_1_i2v_s_fast_portrait_fl"),
+    },
+    "reference": {
+        "landscape": os.environ.get("VIDEO_REFERENCE_LANDSCAPE_MODEL", "veo_3_0_r2v_fast"),
+        "portrait": os.environ.get("VIDEO_REFERENCE_PORTRAIT_MODEL", "veo_3_0_r2v_fast_portrait"),
+    },
+}

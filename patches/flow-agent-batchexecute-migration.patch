+// ─── Flow batchexecute transport ────────────────────────────
+// The migrated Flow frontend no longer emits a bearer token. Its private RPCs
+// must be issued in the signed-in page so cookies and WIZ_global_data are used.
+const BATCH_CAPTCHA_SLOT = '__CAPTCHA__';
+const MAX_BATCH_TEXT = 2000000;
+
+async function runBatchRpc(command) {
+  const tab = await getOrOpenFlowTab();
+  if (!tab) return { error: 'NO_FLOW_TAB' };
+
+  let freq = command.freq;
+  if (command.captchaAction) {
+    const solved = await solveCaptcha(command.id, command.captchaAction);
+    if (!solved?.token) {
+      return { error: `CAPTCHA_FAILED: ${solved?.error || 'no token'}` };
+    }
+    freq = freq.split(BATCH_CAPTCHA_SLOT).join(solved.token);
+  }
+
+  const [injected] = await chrome.scripting.executeScript({
+    target: { tabId: tab.id },
+    world: 'MAIN',
+    args: [command.id, command.rpcid, freq, MAX_BATCH_TEXT, command.match || null],
+    func: async (resultKey, rpcid, freqString, maxText, match) => {
+      const wiz = globalThis.WIZ_global_data || {};
+      const at = wiz.SNlM0e;
+      const sid = wiz.FdrFJe;
+      const bl = wiz.cfb2h;
+      if (!at) return { error: 'NO_AT_TOKEN' };
+      const reqid = Math.floor(Math.random() * 900000) + 100000;
+      const url =
+        `/_/AiSandboxAngularFrontend/data/batchexecute?rpcids=${encodeURIComponent(rpcid)}` +
+        `&f.sid=${encodeURIComponent(sid || '')}&bl=${encodeURIComponent(bl || '')}` +
+        `&hl=es-419&_reqid=${reqid}&rt=c`;
+      const response = await fetch(url, {
+        method: 'POST',
+        credentials: 'include',
+        headers: {
+          'content-type': 'application/x-www-form-urlencoded;charset=UTF-8',
+          'x-same-domain': '1',
+        },
+        body: new URLSearchParams({ 'f.req': freqString, at }),
+      });
+      const text = await response.text();
+      const resultCache = globalThis.__FLOW_AGENT_BATCH_RESULTS ||= {};
+      if (match) {
+        const found = text.indexOf(match);
+        const result = {
+          status: response.status,
+          matched: found !== -1,
+          text: found === -1 ? '' : text.slice(found, found + 800),
+          responseLength: text.length,
+        };
+        resultCache[resultKey] = result;
+        setTimeout(() => delete resultCache[resultKey], 120000);
+        return result;
+      }
+      // Keep only the requested RPC envelope and Google error frames. Large
+      // responses can exceed Chromium's executeScript serialization limit.
+      const selected = [];
+      let matchedRpc = false;
+      let googleError = null;
+      for (const line of text.split('\n')) {
+        const candidate = line.trim();
+        if (!candidate.startsWith('[')) continue;
+        try {
+          const chunk = JSON.parse(candidate);
+          for (const entry of Array.isArray(chunk) ? chunk : []) {
+            if (!Array.isArray(entry)) continue;
+            if (entry[0] === 'wrb.fr' && entry[1] === rpcid) {
+              matchedRpc = true;
+              selected.push(entry);
+            } else if (entry[0] === 'er' || entry[0] === 'e') {
+              googleError ||= entry;
+              selected.push(entry);
+            }
+          }
+        } catch { /* sentinel or length line */ }
+      }
+      const compact = selected.length ? JSON.stringify(selected) : text.slice(0, maxText);
+      const result = {
+        status: response.status,
+        text: compact.slice(0, maxText),
+        responseLength: text.length,
+        compacted: selected.length > 0,
+      };
+      if (!matchedRpc && googleError) {
+        const code = googleError[0] === 'er' ? googleError[5] : googleError[1];
+        result.error = `GOOGLE_BATCH_ERROR: rpc=${rpcid}, frame=${googleError[0]}, code=${code ?? 'unknown'}`;
+      }
+      resultCache[resultKey] = result;
+      setTimeout(() => delete resultCache[resultKey], 120000);
+      return result;
+    },
+  });
+  if (injected?.result) return injected.result;
+
+  // Recover the already completed response from the page. Never resubmit a
+  // generation just because Brave omitted the first return value.
+  await sleep(100);
+  const [recovered] = await chrome.scripting.executeScript({
+    target: { tabId: tab.id },
+    world: 'MAIN',
+    args: [command.id],
+    func: (resultKey) => {
+      const cache = globalThis.__FLOW_AGENT_BATCH_RESULTS || {};
+      const result = cache[resultKey] || null;
+      delete cache[resultKey];
+      return result;
+    },
+  });
+  return recovered?.result || {
+    error: `NO_INJECTION_RESULT: rpc=${command.rpcid}, tab=${tab.id}`,
+  };
+}
+
+async function handleBatchRpc(msg) {
+  const { id, params = {} } = msg;
+  const { rpcid, freq, captchaAction, match } = params;
+  if (!rpcid || !freq) {
+    sendToAgent({ id, status: 400, error: 'INVALID_BATCH_RPC' });
+    return;
+  }
+
+  setState('running');
+  const visible = !!captchaAction;
+  if (visible) {
+    metrics.requestCount++;
+    addRequestLog({
+      id, type: `RPC:${rpcid}`, time: new Date().toISOString(),
+      status: 'processing', error: null, outputUrl: null, url: rpcid,
+      payloadSummary: freq.slice(0, 200),
+    });
+  }
+  try {
+    const output = await runBatchRpc({ id, rpcid, freq, captchaAction, match });
+    if (output.error) {
+      if (visible) {
+        metrics.failedCount++;
+        metrics.lastError = output.error;
+        updateRequestLog(id, { status: 'failed', error: output.error });
+      }
+      sendToAgent({ id, status: 502, error: output.error });
+    } else {
+      if (visible) {
+        metrics.successCount++;
+        metrics.lastError = null;
+        updateRequestLog(id, {
+          status: output.status >= 400 ? 'failed' : 'success',
+          httpStatus: output.status,
+          responseSummary: (output.text || '').slice(0, 300),
+        });
+      }
+      sendToAgent({ id, status: output.status, data: output.text });
+    }
+  } catch (error) {
+    const message = error?.message || 'BATCH_RPC_FAILED';
+    if (visible) {
+      metrics.failedCount++;
+      metrics.lastError = message;
+      updateRequestLog(id, { status: 'failed', error: message });
+    }
+    sendToAgent({ id, status: 500, error: message });
+  } finally {
+    chrome.storage.local.set({ metrics });
+    setState('idle');
+  }
+}

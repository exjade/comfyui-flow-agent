+++ b/flow-agent/flow_engine/flow_batch.py
@@ -0,0 +1,336 @@
+"""Codec and request builders for Flow's flow.google.com batchexecute API.
+
+The current Flow frontend authenticates requests inside the signed-in page with
+cookies plus a per-page ``at`` value.  This module only builds and parses the
+wire format; the browser extension performs the network request.
+
+The wire shapes were independently verified against the migrated frontend and
+are intentionally isolated here because this is an undocumented private API.
+"""
+
+from __future__ import annotations
+
+import json
+import random
+import re
+import uuid
+from dataclasses import dataclass
+from typing import Any, Optional
+
+
+RPC_GEN_IMAGE = "ogiZ0b"
+RPC_GEN_VIDEO_I2V = "eb1hJf"
+RPC_OPERATION = "jwpduf"
+RPC_PROJECT_MEDIA = "Zzl0ze"
+RPC_MEDIA = "as29s"
+RPC_UPLOAD_IMAGE = "maseQ"
+
+CAPTCHA_IMAGE = "IMAGE_GENERATION"
+CAPTCHA_VIDEO = "VIDEO_GENERATION"
+CAPTCHA_SLOT = "__CAPTCHA__"
+MEDIA_HOST = "flow-content.google"
+
+SURFACE_ID = 22
+FULL_FRAME_CROP = [None, 0.0038759689922481244, 1, 0.9961240310077519]
+REF_TYPE_IMAGE = 1
+
+IMAGE_MODEL_ALIASES = {
+    "HARBOR_SEAL": "NARWHAL",
+    "NARWHAL": "NARWHAL",
+    "GEM_PIX_2": "GEM_PIX_2",
+}
+IMAGE_ASPECTS = {
+    "IMAGE_ASPECT_RATIO_SQUARE": 1,
+    "IMAGE_ASPECT_RATIO_PORTRAIT": 2,
+    "IMAGE_ASPECT_RATIO_LANDSCAPE": 3,
+    "IMAGE_ASPECT_RATIO_3_4": 4,
+    "IMAGE_ASPECT_RATIO_PORTRAIT_FOUR_THREE": 4,
+    "IMAGE_ASPECT_RATIO_4_3": 5,
+    "IMAGE_ASPECT_RATIO_LANDSCAPE_FOUR_THREE": 5,
+}
+VIDEO_ASPECTS = {
+    "VIDEO_ASPECT_RATIO_PORTRAIT": 1,
+    "VIDEO_ASPECT_RATIO_LANDSCAPE": 2,
+}
+
+
+class FlowBatchError(RuntimeError):
+    """A batch request or response could not be translated safely."""
+
+
+@dataclass(frozen=True)
+class RpcResult:
+    rpcid: str
+    data: Any
+    error: Any = None
+
+
+@dataclass(frozen=True)
+class Operation:
+    operation_id: str
+    project_id: Optional[str]
+    status: Optional[str]
+    error: Optional[str] = None
+
+
+@dataclass(frozen=True)
+class MediaUrls:
+    media_id: str
+    video: Optional[str] = None
+    image: Optional[str] = None
+
+
+def _uuid() -> str:
+    return str(uuid.uuid4()).upper()
+
+
+def _context(project_id: str) -> list:
+    return [None, SURFACE_ID, None, None, None, project_id, None, None,
+            None, None, [CAPTCHA_SLOT, 1]]
+
+
+def build_envelope(rpcid: str, inner: Any) -> str:
+    return json.dumps(
+        [[[rpcid, json.dumps(inner, separators=(",", ":"), ensure_ascii=False),
+           None, "generic"]]],
+        separators=(",", ":"), ensure_ascii=False,
+    )
+
+
+def parse_envelope(text: str) -> list[RpcResult]:
+    if not text:
+        return []
+    body = text.split("\n", 1)[1] if text.startswith(")]}'") else text
+    decoder = json.JSONDecoder()
+    results = []
+    index = 0
+    while index < len(body):
+        start = body.find("[", index)
+        if start < 0:
+            break
+        try:
+            chunk, consumed = decoder.raw_decode(body[start:])
+        except json.JSONDecodeError:
+            index = start + 1
+            continue
+        index = start + consumed
+        for entry in chunk if isinstance(chunk, list) else []:
+            if not isinstance(entry, list) or not entry or entry[0] != "wrb.fr":
+                continue
+            rpcid = entry[1] if len(entry) > 1 else "?"
+            payload = entry[2] if len(entry) > 2 else None
+            if payload is None:
+                results.append(RpcResult(
+                    rpcid, None, entry[5] if len(entry) > 5 else True
+                ))
+                continue
+            try:
+                data = json.loads(payload) if isinstance(payload, str) else payload
+            except json.JSONDecodeError as exc:
+                raise FlowBatchError(f"{rpcid} returned invalid JSON: {exc}") from exc
+            results.append(RpcResult(rpcid, data))
+    return results
+
+
+def first_payload(text: str, rpcid: str) -> Any:
+    results = parse_envelope(text)
+    for result in results:
+        if result.rpcid != rpcid:
+            continue
+        if result.error is not None:
+            raise FlowBatchError(f"{rpcid} failed: {result.error!r}")
+        return result.data
+    body = text.split("\n", 1)[1] if text.startswith(")]}'") else text
+    error_match = re.search(r'\["er"[^\]]*?,(\d{3})(?:,|\])', body)
+    if error_match:
+        raise FlowBatchError(
+            f"{rpcid} returned Google batch error code {error_match.group(1)}"
+        )
+    if '[["e",' in body or '["e",' in body:
+        raise FlowBatchError(f"{rpcid} returned a Google batch error frame")
+    raise FlowBatchError(
+        f"no {rpcid} envelope in response ({len(results)} other RPC records)"
+    )
+
+
+def _prompt(item: dict) -> str:
+    structured = item.get("structuredPrompt") or {}
+    parts = structured.get("parts") if isinstance(structured, dict) else None
+    if not isinstance(parts, list):
+        return ""
+    return " ".join(
+        str(part.get("text", "")) for part in parts if isinstance(part, dict)
+    ).strip()
+
+
+def _reference_ids(item: dict) -> list[str]:
+    refs = []
+    for value in item.get("imageInputs") or []:
+        if not isinstance(value, dict):
+            continue
+        media_id = value.get("name") or value.get("mediaId")
+        if media_id:
+            refs.append(str(media_id))
+    return refs
+
+
+def image_request_from_legacy(body: dict, project_id: str) -> str:
+    """Translate the existing REST image body without changing ComfyUI callers."""
+    old_items = body.get("requests") or []
+    if not old_items:
+        raise FlowBatchError("image request contains no items")
+    items = []
+    for index, old in enumerate(old_items):
+        if not isinstance(old, dict):
+            continue
+        aspect_name = old.get("imageAspectRatio", "IMAGE_ASPECT_RATIO_SQUARE")
+        if aspect_name not in IMAGE_ASPECTS:
+            raise FlowBatchError(f"unsupported image aspect {aspect_name!r}")
+        model = IMAGE_MODEL_ALIASES.get(old.get("imageModelName"), "NARWHAL")
+        seed = old.get("seed")
+        if not isinstance(seed, int):
+            seed = random.randint(1, 10**9) + index * 9973
+        refs = [[media_id, None, None, None, REF_TYPE_IMAGE]
+                for media_id in _reference_ids(old)] or None
+        items.append([
+            None, None, refs, seed, IMAGE_ASPECTS[aspect_name], model, None,
+            _context(project_id), [[[_prompt(old)]]], None, None, None,
+            _uuid(), _uuid(),
+        ])
+    if not items:
+        raise FlowBatchError("image request contains no valid items")
+    return build_envelope(
+        RPC_GEN_IMAGE, [None, items, 1, _context(project_id), [_uuid()]]
+    )
+
+
+def upload_image_request(image_b64: str, project_id: str,
+                         mime_type: str = "image/jpeg",
+                         file_name: str = "upload.jpg") -> str:
+    return build_envelope(RPC_UPLOAD_IMAGE, [
+        _context(project_id), image_b64, mime_type, 1, None, None, None, None,
+        file_name, None, _uuid(), _uuid(),
+    ])
+
+
+def _video_model(old: Optional[str]) -> str:
+    value = str(old or "")
+    if "ultra" in value:
+        return "veo_3_1_i2v_s_fast_ultra"
+    if "lite" in value and "low_priority" not in value:
+        return "veo_3_1_i2v_lite"
+    return "veo_3_1_i2v_lite_low_priority"
+
+
+def video_i2v_request_from_legacy(item: dict, project_id: str) -> str:
+    start = item.get("startImage") or {}
+    media_id = start.get("mediaId") if isinstance(start, dict) else None
+    if not media_id:
+        raise FlowBatchError("image-to-video request has no start image")
+    aspect_name = item.get("aspectRatio", "VIDEO_ASPECT_RATIO_LANDSCAPE")
+    if aspect_name not in VIDEO_ASPECTS:
+        raise FlowBatchError(f"unsupported video aspect {aspect_name!r}")
+    text_input = item.get("textInput") or {}
+    prompt = _prompt(text_input if isinstance(text_input, dict) else {})
+    inner = [
+        [[[None, None, [[[prompt]]]], _video_model(item.get("videoModelKey")),
+          VIDEO_ASPECTS[aspect_name], None,
+          [None, str(media_id), None, None, None, FULL_FRAME_CROP],
+          [None, None, None, None, _uuid(), _uuid()]]],
+        _context(project_id),
+        [_uuid(), 2],
+    ]
+    return build_envelope(RPC_GEN_VIDEO_I2V, inner)
+
+
+def operation_request(operation_id: str) -> str:
+    return build_envelope(RPC_OPERATION, [None, None, [[operation_id]]])
+
+
+def project_media_request(project_id: str) -> str:
+    return build_envelope(
+        RPC_PROJECT_MEDIA, [f"projects/{project_id}", None, None, None, [1]]
+    )
+
+
+def media_request(media_id: str) -> str:
+    return build_envelope(RPC_MEDIA, [media_id])
+
+
+def _walk_strings(node: Any):
+    if isinstance(node, str):
+        yield node
+    elif isinstance(node, list):
+        for item in node:
+            yield from _walk_strings(item)
+
+
+def _walk_lists(node: Any):
+    if isinstance(node, list):
+        yield node
+        for item in node:
+            yield from _walk_lists(item)
+
+
+def read_images(payload: Any) -> list[dict]:
+    images = []
+    seen = set()
+    for value in _walk_strings(payload):
+        if MEDIA_HOST + "/image/" not in value:
+            continue
+        media_id = value.split("/image/", 1)[1].split("?", 1)[0]
+        if media_id in seen:
+            continue
+        seen.add(media_id)
+        images.append({"media_id": media_id, "image_url": value})
+    return images
+
+
+def read_uploaded_media_id(payload: Any) -> str:
+    record = payload[0] if isinstance(payload, list) and payload else None
+    media_id = record[0] if isinstance(record, list) and record else None
+    if not isinstance(media_id, str) or not media_id:
+        raise FlowBatchError("upload response carried no media id")
+    return media_id
+
+
+def read_operation(payload: Any) -> Operation:
+    records = payload[2] if isinstance(payload, list) and len(payload) > 2 else None
+    record = records[0] if isinstance(records, list) and records else None
+    if not isinstance(record, list) or not record:
+        raise FlowBatchError("operation payload carried no record")
+    status = record[3] if len(record) > 3 else None
+    return Operation(str(record[0]), record[1] if len(record) > 1 else None, status)
+
+
+_MEDIA_SLOT = re.compile(r'null,null,\\?"([0-9a-fA-F-]{36})\\?"')
+
+
+def find_media_id_in_text(text: str, operation_id: str) -> Optional[str]:
+    start = text.find(operation_id)
+    if start < 0:
+        return None
+    match = _MEDIA_SLOT.search(text, start, start + 800)
+    return match.group(1) if match else None
+
+
+def find_media_id(payload: Any, operation_id: str) -> Optional[str]:
+    for node in _walk_lists(payload):
+        if len(node) < 4 or node[0] != operation_id:
+            continue
+        detail = node[3]
+        if isinstance(detail, list) and len(detail) > 4 and isinstance(detail[4], str):
+            return detail[4]
+    return None
+
+
+def read_media_urls(payload: Any, media_id: str) -> MediaUrls:
+    video = image = None
+    for value in _walk_strings(payload):
+        if not value.startswith("https://"):
+            continue
+        if MEDIA_HOST + "/video/" in value and video is None:
+            video = value
+        elif MEDIA_HOST + "/image/" in value and image is None:
+            image = value
+    return MediaUrls(media_id=media_id, video=video, image=image)

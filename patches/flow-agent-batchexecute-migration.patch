+    async def _batch_rpc(self, rpcid, freq, captcha_action="", *, match=None,
+                         timeout=None, meta=None, client_id=None):
+        """Run one RPC inside the signed-in Flow page through the extension."""
+        client_id = client_id or target_client_id_var.get() or self._select_client()
+        if not client_id:
+            return {"error": "No extensions connected", "status": 503}
+        if captcha_action:
+            await self._wait_startup_cooldown()
+            await self._space_out_global_requests()
+        req_id = str(uuid.uuid4())
+        future = self._loop.create_future()
+        self._pending[req_id] = future
+        self._remember_request(req_id, {
+            "captcha_action": captcha_action,
+            "url_path": f"batchexecute:{rpcid}",
+            "client_id": client_id,
+            **(meta or {}),
+        })
+        params = {"rpcid": rpcid, "freq": freq}
+        if captcha_action:
+            params["captchaAction"] = captcha_action
+        if match:
+            params["match"] = match
+        self._states[client_id] = "running"
+        sent = await self.send_message_to(client_id, {
+            "id": req_id, "method": "batch_rpc", "params": params,
+        })
+        if not sent:
+            self._pending.pop(req_id, None)
+            return {"error": "Extension command could not be delivered", "status": 503}
+        try:
+            result = await asyncio.wait_for(

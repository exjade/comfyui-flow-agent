+import json
+
+import pytest
+
+from flow_engine import flow_batch as fb
+
+
+PROJECT = "88d1a5dc-0856-4576-917a-6215de3c4fd9"
+
+
+def _inner(freq):
+    outer = json.loads(freq)
+    return outer[0][0][0], json.loads(outer[0][0][1])
+
+
+def test_image_translation_preserves_prompt_seed_model_aspect_and_captcha():
+    freq = fb.image_request_from_legacy({"requests": [{
+        "structuredPrompt": {"parts": [{"text": "portrait test"}]},
+        "imageAspectRatio": "IMAGE_ASPECT_RATIO_PORTRAIT",
+        "imageModelName": "GEM_PIX_2",
+        "seed": 43,
+    }]}, PROJECT)
+
+    rpcid, inner = _inner(freq)
+    item = inner[1][0]
+    assert rpcid == fb.RPC_GEN_IMAGE
+    assert item[3] == 43
+    assert item[4] == 2
+    assert item[5] == "GEM_PIX_2"
+    assert item[8] == [[["portrait test"]]]
+    assert fb.CAPTCHA_SLOT in freq
+
+
+def test_image_translation_preserves_reference_media_ids():
+    media_id = "11111111-2222-3333-4444-555555555555"
+    freq = fb.image_request_from_legacy({"requests": [{
+        "structuredPrompt": {"parts": [{"text": "same character"}]},
+        "imageAspectRatio": "IMAGE_ASPECT_RATIO_SQUARE",
+        "imageInputs": [{"name": media_id}],
+    }]}, PROJECT)
+
+    _, inner = _inner(freq)
+    assert inner[1][0][2] == [[media_id, None, None, None, 1]]
+
+
+def test_i2v_translation_requires_and_embeds_start_image():
+    media_id = "11111111-2222-3333-4444-555555555555"
+    freq = fb.video_i2v_request_from_legacy({
+        "aspectRatio": "VIDEO_ASPECT_RATIO_LANDSCAPE",
+        "textInput": {"structuredPrompt": {"parts": [{"text": "move slowly"}]}},
+        "videoModelKey": "veo_3_1_i2v_s_fast_ultra",
+        "startImage": {"mediaId": media_id},
+    }, PROJECT)
+    rpcid, inner = _inner(freq)
+    assert rpcid == fb.RPC_GEN_VIDEO_I2V
+    assert media_id in json.dumps(inner)
+    assert "move slowly" in json.dumps(inner)
+
+    with pytest.raises(fb.FlowBatchError, match="no start image"):
+        fb.video_i2v_request_from_legacy({}, PROJECT)
+
+
+def test_parse_envelope_ignores_transport_frames_and_reads_rpc_payload():
+    payload = [None, [["ok"]]]
+    frame = [["wrb.fr", fb.RPC_GEN_IMAGE, json.dumps(payload), None, None, None,
+              "generic"]]
+    text = ")]}'\n103 [[\"di\",15]]\n" + json.dumps(frame)
+    assert fb.first_payload(text, fb.RPC_GEN_IMAGE) == payload
+
+
+def test_outer_http_200_with_only_error_frame_is_not_success():
+    text = ")]}'\n103 [[\"er\",null,null,null,null,405,null,null,null,9]]\n"
+    with pytest.raises(fb.FlowBatchError, match="batch error code 405"):
+        fb.first_payload(text, fb.RPC_GEN_IMAGE)
+
+
+def test_signed_image_and_video_urls_are_read_by_shape():
+    image_id = "11111111-2222-3333-4444-555555555555"
+    video_id = "aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee"
+    image_url = f"https://flow-content.google/image/{image_id}?sig=x"
+    video_url = f"https://flow-content.google/video/{video_id}?sig=y"
+    assert fb.read_images([[image_url]]) == [{
+        "media_id": image_id, "image_url": image_url,
+    }]
+    urls = fb.read_media_urls([[image_url], [video_url]], video_id)
+    assert urls.image == image_url
+    assert urls.video == video_url

+def _validation_ttl_seconds() -> int:
+    """How long a just-confirmed Flow media ID is trusted without a GET probe."""
+
+    try:
+        return max(0, int(os.environ.get("MEDIA_ID_VALIDATION_TTL_SECONDS", "21600")))
+    except (TypeError, ValueError):
+        return 21600
+
+
+def _validation_is_fresh(record: dict) -> bool:
+    try:
+        validated_at = int(record.get("validated_at") or 0)
+    except (TypeError, ValueError):
+        return False
+    return bool(
+        validated_at
+        and (int(time.time()) - validated_at) <= _validation_ttl_seconds()
+    )
+
+

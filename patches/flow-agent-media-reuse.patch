+def _clean_media_id_aliases(value: Any, *, current: str | None = None) -> list[str]:
+    """Return unique legacy media IDs, excluding the current ID."""
+
+    values = value if isinstance(value, (list, tuple, set)) else []
+    aliases: list[str] = []
+    for raw in values:
+        alias = _clean_string(raw)
+        if alias and alias != current and alias not in aliases:
+            aliases.append(alias)
+    return aliases
+
+
+def _media_ids(entry: Mapping[str, Any]) -> set[str]:
+    current = _clean_string(entry.get("media_id"))
+    ids = set(_clean_media_id_aliases(entry.get("media_id_aliases"), current=current))
+    if current:
+        ids.add(current)
+    return ids
+
+

# These variables belong on RunPod, in the environment that starts ComfyUI.
FLOW_AGENT_BASE_URL=https://replace-me.ngrok-free.app
FLOW_AGENT_API_KEY=replace-with-the-same-value-as-SERVER_API_KEY

# Optional client-side safeguards.
FLOW_AGENT_CONNECT_TIMEOUT_SECONDS=10
FLOW_AGENT_MAX_DOWNLOAD_MB=64
FLOW_AGENT_MAX_VIDEO_DOWNLOAD_MB=2048
FLOW_AGENT_MAX_UPLOAD_MB=2048
